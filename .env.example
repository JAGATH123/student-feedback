# Copy to .env and fill in values before deploying

# PostgreSQL
POSTGRES_DB=kiosk
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=changeme_in_production

# Backend
DATABASE_URL=postgresql://kiosk:changeme_in_production@db:5432/kiosk

# Frontend (leave empty to use Next.js rewrite proxy)
NEXT_PUBLIC_API_URL=
